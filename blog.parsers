// Scroll 180's linkify directive inherits markup matching. It is a setting,
// so exclude it from text replacements and markup validation.
blogLinkifyParser
 extends linkifyParser
 cue linkify
 boolean isMarkup false

// Semantic attributes missing from this version of the built-in element parsers.
blogAriaAttributeParser
 extends abstractAftertextAttributeParser
 pattern ^aria\-
 catchAllAtomType htmlAnyAtom

blogDatetimeParser
 extends abstractAftertextAttributeParser
 cue datetime
 catchAllAtomType htmlAnyAtom

blogLoadingParser
 extends abstractAftertextAttributeParser
 cue loading
 catchAllAtomType htmlAnyAtom

superscriptParser
 extends abstractMarkupParser
 cue superscript
 string tag sup

subscriptParser
 extends abstractMarkupParser
 cue subscript
 string tag sub

blogTimeParser
 extends abstractHtmlElementParser
 cue time

blogFigureParser
 extends abstractHtmlElementParser
 cue figure

// Scroll 180 indexes posts by date but looks up those indexes in filename order.
// Supply correctly ordered neighbors to its existing keyboardNav handler.
blogKeyboardNavParser
 extends keyboardNavParser
 cue keyboardNav
 javascript
  getAtom(index) {
   const explicit = super.getAtom(index)
   if (explicit !== undefined || (index !== 1 && index !== 2)) return explicit
   const posts = this.root.allScrollFiles.map(file => file.scrollProgram)
    .filter(post => post.buildsHtml && !post.importOnly && post.hasKeyboardNav && post.primaryTag === this.root.primaryTag)
    .sort((a, b) => a.timestamp - b.timestamp || a.permalink.localeCompare(b.permalink))
   const position = posts.findIndex(post => post.permalink === this.root.permalink)
   if (position < 0 || !posts.length) return this.root.permalink
   return posts[(position + (index === 1 ? -1 : 1) + posts.length) % posts.length].permalink
  }

// Presentation for Scroll's postsMeta table; discovery and ordering stay native.
printArchiveParser
 extends abstractTableVisualizationParser
 cue printArchive
 javascript
  buildHtml() {
   const groups = new Map()
   for (const post of this.parent.coreTable) {
    const program = this.root.allScrollFiles.find(file => file.scrollProgram.permalink === post.permalink)?.scrollProgram
    post.publicationLabel = (program?.get("//") || "").replace(/^publicationLabel /, "")
    if (post.publicationLabel === "Date not stated") post.year = "Undated"
    if (!groups.has(post.year)) groups.set(post.year, [])
    groups.get(post.year).push(post)
   }
   const source = [...groups].sort((a,b) => a[0] === "Undated" ? 1 : b[0] === "Undated" ? -1 : Number(b[0])-Number(a[0])).map(([year, posts]) => {
    const rows = posts.map(post => {
     const date = post.publicationLabel === "Date not stated" || /^\d{4}$/.test(post.publicationLabel) ? "" : this.root.dayjs(post.date).format("MMM")
     return `  a\n   href ${post.permalink}\n   addClass post-row\n   time ${date}\n    datetime ${this.root.dayjs(post.date).format("YYYY-MM-DD")}\n   span ${post.title}\n    addClass post-title\n   span ${post.minutes} min\n    addClass read-time\n   span ↗\n    addClass row-arrow\n    aria-hidden true`
    }).join("\n")
    return `section\n addClass year-group\n data-year ${year}\n aria-label Writing from ${year}\n h3 ${year}\n div\n  addClass year-posts\n${rows}`
   }).join("\n")
   const particles = this.root.concat(source)
   const html = particles.map(particle => particle.buildHtml()).join("\n")
   particles.forEach(particle => particle.destroy())
   return html
  }

originalLinkParser
 extends scrollLinkParser
 cue originalLink
 atoms cueAtom
 javascript
  get link() {
   const url = this.root.get("canonicalUrl") || ""
   return url.startsWith("https://paulgraham.com/") ? url : "https://paulgraham.com/"
  }

viewSourceParser
 extends editLinkParser
 cue viewSource
 string text View source
 javascript
  get link() { return this.root.filename }
  buildTxt() { return "" }

// Preserve the source's actual publication-date precision.
blogPrintDateParser
 extends printDateParser
 cue printDate
 javascript
  get day() { return (this.root.get("//") || "").replace(/^publicationLabel /, "") }

// Format navigation belongs to the HTML interface, not the essay export.
blogFormatLinksParser
 extends printFormatLinksParser
 cue printFormatLinks
 javascript
  buildTxt() { return "" }

// Do not expose the internal ordering date for essays without a stated date.
blogPostsParser
 extends scrollPostsParser
 cue posts
 javascript
  postToRow(file) {
   const row = super.postToRow(file)
   if (file.file.scrollProgram.get("//") === "publicationLabel Date not stated") row.year = "Undated"
   return row
  }
